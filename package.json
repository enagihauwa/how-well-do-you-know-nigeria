{
  "name": "how-well-do-you-know-nigeria",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @naija/web",
    "dev:server": "npm run dev -w @naija/server",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "npm run build -w @naija/web",
    "start": "npm run start -w @naija/web",
    "server": "npm run start -w @naija/server",
    "lint": "eslint",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "npm run bench -w @naija/game",
    "load": "npm run load -w @naija/server --"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
