# Copy to .env for local development. Every setting is optional locally.

# Postgres for accounts and progress. Unset: kept in memory, lost on restart.
# DATABASE_URL=postgres://localhost/naija_trivia

# Signs session tokens. Required in production: openssl rand -base64 32
# BETTER_AUTH_SECRET=

# This server's public URL (production), e.g. https://naija-rooms.up.railway.app
# PUBLIC_URL=

# Comma-separated sites allowed to use the server, e.g. https://naijaquiz.app. Unset: any.
# ALLOWED_ORIGINS=

# Testing Quick Play with few people.
# QUICKPLAY_MIN_PLAYERS=2
# QUICKPLAY_COUNTDOWN_MS=5000
